# Server Configuration
PORT=3000
NODE_ENV=development

# ApplyWizz API Configuration
APPLYWIZZ_API_URL=https://www.apply-wizz.me/api

# LLM Provider Configuration ('gemini' | 'openai')
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Playwright & Scanner Configuration
PLAYWRIGHT_TIMEOUT=30000
WORKER_POOL_SIZE=4
SCANNER_JITTER_MIN_MS=3000
SCANNER_JITTER_MAX_MS=6000

# File Paths
INPUT_CSV_PATH=./greenhouse_only_applywizz_prod(in).csv
OUTPUT_DIR=./output
RESUMES_DIR=./resumes
