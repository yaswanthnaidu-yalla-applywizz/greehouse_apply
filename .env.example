# Greenhouse Job Application Automation (V1) Environment Configuration

# Server & Dashboard Configuration
PORT=3001
NODE_ENV=development
# CORS allowed origins (comma-separated if multiple; default: false / same-origin only)
ALLOWED_ORIGINS=https://gh.applywizz.ai

# ApplyWizz Candidate API Endpoint
APPLYWIZZ_API_URL=

# LLM Synthesis Provider Configuration
# Supported providers: 'openrouter' (default), 'gemini', 'openai'
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Recommended)
# Model: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Other Supported Provider Keys (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# Playwright Web Scanner Configuration
PLAYWRIGHT_TIMEOUT=30000
WORKER_POOL_SIZE=4
SCANNER_JITTER_MIN_MS=3000
SCANNER_JITTER_MAX_MS=6000

# File Paths
INPUT_CSV_PATH=./greenhouse_only_applywizz_prod(in).csv
OUTPUT_DIR=./output
RESUMES_DIR=./resumes
MAX_JOB_QUESTIONS=35

# Supabase Configuration (V2)
SUPABASE_URL=
# Anon / publishable key (browser Realtime + dashboard reads). NOT service_role.
SUPABASE_SERVICE_KEY=
# Service role secret (server DB/Storage only).
SUPABASE_SERVICE_ROLE_KEY=
# Optional browser-key override (default: SUPABASE_SERVICE_KEY when SERVICE_ROLE_KEY is set)
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET_RESUMES=resumes
SUPABASE_STORAGE_BUCKET_PROOFS=proofs_web

# Zoho Mail Reader Connector Configuration
ZOHO_CONNECTOR_URL=https://zoho-mail-reader.onrender.com/
ZOHO_CONNECTOR_USER=
ZOHO_CONNECTOR_PASS=
ZOHO_OTP_WORKER_POOL_SIZE=15
OTP_RESOLUTION_POLL_INTERVAL_MS=10000
OTP_ATTEMPT_TIMEOUT_MS=30000
ZOHO_READER_EMAIL=
ZOHO_READER_PASSWORD=

# Azure Communication Services / Microsoft 365 Email
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MS365_TENANT_ID=
AZURE_TENANT_ID=
AZURE_SENDER_EMAIL=
AZURE_COMMUNICATION_ENDPOINT=

# ApplyWizz CA Management & Signup Authorization
AUTHORIZED_EMAILS_API=https://applywizz-ca-management.vercel.app/api/ca/emails
ALLOWED_SIGNUP_EMAILS=yaswanthnaiduyalla@applywizz.ai

# ApplyWizz S3 Bucket Base URL
APPLYWIZZ_S3_BASE_URL=https://applywizz-prod.s3.us-east-2.amazonaws.com

# OpenRouter Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://apply-wizz.me

# Microsoft 365 / Entra ID Graph Endpoints
MS_LOGIN_BASE_URL=https://login.microsoftonline.com
MS_GRAPH_BASE_URL=https://graph.microsoft.com

# Multi-Service Architecture (Railway)
# External worker service URL for Playwright dry-run / submissions (set on Service 1)
WORKER_SERVICE_URL=
# Service 1's Railway private URL for cross-service WebSocket events and callbacks (set on Service 3)
WEB_SERVICE_URL=
# Shared secret for inter-service internal worker routes (/api/internal/*) (set identically across services)
INTERNAL_API_SECRET=

